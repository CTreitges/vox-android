<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-Icon-Hintergrund (UX-Spec §4.1): Vollflaeche primaryContainer #0F5B50,
     darueber radialer Verlauf Mitte (54,48), Radius 64: #177066 -> #0F5B50. Keine weiteren Formen. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#0F5B50"
        android:pathData="M0,0 H108 V108 H0 Z" />
    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="48"
                android:gradientRadius="64">
                <item android:offset="0" android:color="#177066" />
                <item android:offset="1" android:color="#0F5B50" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
