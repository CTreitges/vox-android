<?xml version="1.0" encoding="utf-8"?>
<!-- Tasten der Diktier-Tastatur (UX-Spec §5.3): Radius 12, Fuellung loom_surfaceContainerHigh,
     gedrueckt loom_surfaceContainerHighest, Ripple loom_onSurface @ 12 %. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/key_ripple">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/loom_surfaceContainerHighest" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/loom_surfaceContainerHigh" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
