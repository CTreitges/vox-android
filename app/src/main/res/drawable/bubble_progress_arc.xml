     Dreht sich per BubbleAnimators.spin() einmal pro Sekunde. Viewport = dp, damit der
     Strich exakt 3 dp bleibt. Start oben (38,1.5), im Uhrzeigersinn bis links (1.5,38). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="76dp"
    android:height="76dp"
    android:viewportWidth="76"
    android:viewportHeight="76">
    <path
        android:strokeColor="@color/loom_primary"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="M38,1.5 A36.5,36.5 0 1 1 1.5,38" />
</vector>
