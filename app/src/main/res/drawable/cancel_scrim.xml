<?xml version="1.0" encoding="utf-8"?>
<!-- Scrim ueber dem unteren Bildschirmviertel waehrend des Ziehens (UX-Spec §5.2):
     senkrechter Verlauf transparent (oben) -> wb_scrim = Schwarz 40 % (unten). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@android:color/transparent"
        android:endColor="@color/wb_scrim" />
</shape>
