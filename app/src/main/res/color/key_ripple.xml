<?xml version="1.0" encoding="utf-8"?>
<!-- Ripple der Tasten: loom_onSurface @ 12 % (UX-Spec §5.3). android:alpha auf ColorStateList-Items
     gibt es seit API 23 — so bleibt der Hex-Wert in colors.xml. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/loom_onSurface" android:alpha="0.12" />
</selector>
