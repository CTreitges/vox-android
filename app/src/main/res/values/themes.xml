<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Framework-Theme (kein AppCompat). Fest dunkel: verhindert den weissen Frame vor dem ersten
         Compose-Frame. Theme.Material.NoActionBar gibt es seit API 21
         (https://developer.android.com/reference/android/R.style). Die Bildschirm-Titel stehen in den
         Layouts, deshalb keine ActionBar. Kein Dynamic Color: Compose ueberdeckt das Framework-Theme. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/wb_background</item>
        <item name="android:colorPrimary">@color/wb_primary</item>
        <item name="android:colorAccent">@color/wb_primary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Helle Icons auf dunklem Grund (Statusleiste API 23+, Navigationsleiste API 27+). -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>

    <!-- Diktier-Tastatur, Tastenreihe (UX-Spec §5.3): Hoehe 48 dp (56 ab fontScale 1,3 — im Code),
         minWidth 44, Radius 12, Fuellung wb_surfaceContainerHigh, gedrueckt wb_surfaceContainerHighest.
         Kein stateListAnimator: die Material-Button-Anhebung wirft auf dem dunklen Grund Schatten. -->
    <style name="Key">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:layout_marginHorizontal">2dp</item>
        <item name="android:background">@drawable/key_bg</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minWidth">44dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:paddingVertical">0dp</item>
        <item name="android:textColor">@color/wb_onSurface</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">18sp</item>
    </style>

    <!-- Icon-Taste: 22-dp-Symbol in wb_onSurface, Rest wie Key. -->
    <style name="KeyIcon" parent="Key">
        <item name="android:paddingHorizontal">11dp</item>
        <item name="android:paddingVertical">13dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/wb_onSurface</item>
    </style>
</resources>
