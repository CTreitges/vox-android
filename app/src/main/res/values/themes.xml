<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Framework-Theme (kein AppCompat noetig). Ohne ActionBar — die Bildschirme
      bringen ihre eigene, kompaktere Kopfzeile mit.
    -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Ueberschrift eines Abschnitts -->
    <style name="TextTitle">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextSection">
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>


    <style name="TextHint">
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <!-- Grosser, gefuellter Hauptknopf -->
    <style name="ButtonPrimary">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Flacher Zweitknopf -->
    <style name="ButtonGhost">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/bg_button_ghost</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingHorizontal">18dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Auswahl-Chip (Sprache, Tempo) -->
    <style name="Chip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <!-- Tastatur-Utility-Taste -->
    <style name="Key">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">3dp</item>
        <item name="android:background">@drawable/bg_key</item>
        <item name="android:textColor">@color/kb_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">17sp</item>
        <item name="android:paddingHorizontal">4dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Tastatur-Taste mit Symbol statt Text -->
    <style name="KeyIcon" parent="Key">
        <item name="android:padding">13dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="Switch">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
