<?xml version="1.0" encoding="utf-8"?>
<!--
  Diktat-Tastatur. Aufbau von oben nach unten:
   1. Statuszeile mit Einstellungs-Taste
   2. Wellenform (nur waehrend der Aufnahme sichtbar aktiv)
   3. grosser Mikro-Orb — tippen ODER halten
   4. eine Reihe Bearbeitungs-Tasten inkl. "Diktat zurueck"
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/kb_background"
    android:paddingHorizontal="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <TextView
            android:id="@+id/status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingStart="40dp"
            android:textColor="@color/kb_text_dim"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/kb_hint_idle" />

        <ImageButton
            android:id="@+id/key_settings"
            android:layout_width="40dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_row"
            android:contentDescription="@string/open_settings"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <com.chris.whisperbar.ui.WaveformView
        android:id="@+id/waveform"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="2dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="106dp">

        <com.chris.whisperbar.ui.MicOrbView
            android:id="@+id/mic"
            android:layout_width="102dp"
            android:layout_height="102dp"
            android:layout_gravity="center"
            android:contentDescription="@string/cd_mic" />

        <ImageView
            android:id="@+id/mic_icon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_mic" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <ImageButton
            android:id="@+id/key_globe"
            style="@style/KeyIcon"
            android:contentDescription="@string/cd_switch_keyboard"
            android:src="@drawable/ic_globe" />

        <ImageButton
            android:id="@+id/key_undo"
            style="@style/KeyIcon"
            android:contentDescription="@string/cd_undo"
            android:src="@drawable/ic_undo" />

        <Button
            android:id="@+id/key_comma"
            style="@style/Key"
            android:text="," />

        <Button
            android:id="@+id/key_space"
            style="@style/Key"
            android:layout_weight="3"
            android:text="@string/kb_space" />

        <Button
            android:id="@+id/key_period"
            style="@style/Key"
            android:text="." />

        <ImageButton
            android:id="@+id/key_backspace"
            style="@style/KeyIcon"
            android:contentDescription="@string/cd_backspace"
            android:src="@drawable/ic_backspace" />

        <ImageButton
            android:id="@+id/key_enter"
            style="@style/KeyIcon"
            android:background="@drawable/bg_key_accent"
            android:contentDescription="@string/cd_enter"
            android:src="@drawable/ic_enter" />
    </LinearLayout>
</LinearLayout>
