<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/kb_background"
    android:paddingHorizontal="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingVertical="6dp"
        android:textColor="@color/kb_text_dim"
        android:textSize="13sp"
        android:text="@string/kb_hint_hold" />

    <View
        android:id="@+id/level"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginHorizontal="40dp"
        android:layout_marginBottom="6dp"
        android:background="@color/accent"
        android:scaleX="0"
        android:alpha="0.9" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="118dp">

        <ImageButton
            android:id="@+id/mic"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center"
            android:background="@drawable/mic_button_bg"
            android:contentDescription="@string/cd_mic"
            android:scaleType="center"
            android:src="@drawable/ic_mic" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <Button
            android:id="@+id/key_globe"
            style="@style/Key"
            android:text="🌐" />

        <Button
            android:id="@+id/key_comma"
            style="@style/Key"
            android:text="," />

        <Button
            android:id="@+id/key_space"
            style="@style/Key"
            android:layout_weight="1"
            android:text="@string/kb_space" />

        <Button
            android:id="@+id/key_period"
            style="@style/Key"
            android:text="." />

        <Button
            android:id="@+id/key_backspace"
            style="@style/Key"
            android:text="⌫" />

        <Button
            android:id="@+id/key_enter"
            style="@style/Key"
            android:text="⏎" />

        <Button
            android:id="@+id/key_settings"
            style="@style/Key"
            android:text="⚙" />
    </LinearLayout>
</LinearLayout>
