<?xml version="1.0" encoding="utf-8"?>
<!-- Ablege-Ziel zum Abbrechen: erscheint am unteren Rand, sobald ein laufendes
     oder fehlgeschlagenes Diktat weggezogen werden kann. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cancel_target"
    android:layout_width="64dp"
    android:layout_height="64dp"
    android:background="@drawable/cancel_bg"
    android:gravity="center"
    android:text="✕"
    android:textColor="@color/kb_text"
    android:textSize="26sp"
    android:elevation="6dp"
    android:contentDescription="@string/cd_cancel" />
