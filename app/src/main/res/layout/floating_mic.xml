<?xml version="1.0" encoding="utf-8"?>
<!-- Schwebender Diktat-Knopf. Der Timer haengt unter dem Kreis und wird nur
     waehrend der Aufnahme eingeblendet, der Spinner nur waehrend der Uebertragung. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="4dp">

    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp">

        <ImageView
            android:id="@+id/bubble_mic"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bubble_bg"
            android:contentDescription="@string/cd_mic"
            android:padding="13dp"
            android:elevation="6dp"
            android:src="@drawable/ic_mic" />

        <ProgressBar
            android:id="@+id/bubble_progress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:elevation="7dp"
            android:indeterminateTint="@color/kb_text"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/bubble_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="@drawable/label_bg"
        android:paddingHorizontal="6dp"
        android:paddingVertical="1dp"
        android:elevation="6dp"
        android:textColor="@color/kb_text"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>
